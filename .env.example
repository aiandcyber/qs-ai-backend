# QS AI Backend — environment template
# Copy to .env and fill in secrets. Never commit .env.

# Providers: openai | anthropic | openai_compatible
MODEL_PROVIDER=openai
MODEL_ID=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_MAX_TOKENS=4096

OPENAI_MODEL_ID=gpt-4o
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

ANTHROPIC_MODEL_ID=claude-sonnet-4-6
# ANTHROPIC_API_KEY=

CPECS_MODE=mock
# CPECS_BASE_URL=
DATA_GOV_HK_ENABLED=true

# dev = no login required; auth0 = require Bearer JWT
AUTH_MODE=dev
# AUTH0_DOMAIN=
# AUTH0_AUDIENCE=

CORS_ORIGINS=http://localhost:5173,https://qs.ai-forall.org
STORAGE_BACKEND=local
